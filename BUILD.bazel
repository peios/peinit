load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_shared_library", "rust_test")
load("//build:checks.bzl", "host_test")
load("//build:version.bzl", "VERSION")
load("//packages:package.bzl", "package_store")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Cargo.toml",
    "Cargo.lock",
])

_PORTABLE_DEPS = [
    "@crates//:jiff",
    "@crates//:libc",
    "@crates//:serde_json",
    "@crates//:sha1",
]

_NATIVE_DEPS = _PORTABLE_DEPS + [
    "@crates//:peios_native",
    "@crates//:auth_core_native",
]

_FEATURES = [
    "peios-boundary",
    "peios-registry",
]

rust_library(
    name = "portable",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "peinit",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = VERSION,
    deps = _PORTABLE_DEPS,
)

rust_test(
    name = "tests",
    size = "medium",
    crate = ":portable",
    env = {"TMPDIR": "/tmp"},
)

rust_library(
    name = "peinit",
    srcs = glob(["src/**/*.rs"]),
    compile_data = [
        "Cargo.toml",
        "Cargo.lock",
        "LICENSE",
        "docs/peinit.evman",
    ],
    crate_features = _FEATURES,
    crate_name = "peinit",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = VERSION,
    deps = _NATIVE_DEPS,
)

rust_test(
    name = "guest-tests",
    size = "medium",
    crate = ":peinit",
    tags = [
        "manual",
        "peios-kernel",
    ],
)

[
    rust_binary(
        name = name,
        srcs = ["src/bin/" + name + ".rs"],
        crate_features = _FEATURES,
        edition = "2024",
        version = VERSION,
        deps = [":peinit"],
    )
    for name in [
        "peinit2",
        "svctl",
    ]
]

rust_shared_library(
    name = "shared",
    srcs = glob(["src/**/*.rs"]),
    compile_data = [
        "Cargo.toml",
        "Cargo.lock",
        "LICENSE",
        "docs/peinit.evman",
    ],
    crate_features = _FEATURES,
    crate_name = "peinit",
    crate_root = "src/lib.rs",
    edition = "2024",
    rustc_flags = ["-Clink-arg=-Wl,-soname,libpeinit.so.0"],
    version = VERSION,
    deps = _NATIVE_DEPS,
)

filegroup(
    name = "artifacts",
    srcs = [
        ":peinit2",
        ":shared",
        ":svctl",
    ],
)

filegroup(
    name = "package-data",
    srcs = [
        "Cargo.lock",
        "Cargo.toml",
        "LICENSE",
        "peinit.pc.in",
        "//packages:definitions",
    ] + glob([
        "include/**",
        "docs/man/*",
        "docs/*.regman",
        "docs/*.evman",
        "third-party/*",
    ]),
)

filegroup(
    name = "package-sources",
    srcs = glob(
        [
            "src/**",
            "include/**",
            "abi/**",
            "tests/**",
            "docs/**",
            "third-party/**",
            "*.toml",
            "*.lock",
            "*.md",
            "*.in",
            "*.rs",
            "LICENSE",
            "BUILD.bazel",
            "MODULE.bazel*",
            "bazel",
            ".bazel*",
            ".gitignore",
            ".github/**",
        ],
        exclude = [
            "docs/archive/**",
            "docs/learn/dist/**",
        ],
    ) + [
        "//build:sources",
        "//packages:sources",
        "//tools:sources",
        "//vendor:sources",
    ],
)

package_store(
    name = "packages",
    packages = ["//packages:all"],
)

host_test(
    name = "abi-test",
    size = "small",
    command = "tools/verify-abi.sh && python3 tools/check-library.py $(rootpath :shared) $(rootpath @peios_sdk//:library)",
    data = [
        "Cargo.toml",
        "cbindgen.toml",
        "tests/library.c",
        ":shared",
        "//tools:check-library.py",
        "//tools:verify-abi.sh",
        "@peios_sdk//:library",
    ] + glob([
        "include/**",
        "abi/**",
        "src/capi/**",
    ]),
    tags = [
        "external",
        "no-remote",
    ],
)

host_test(
    name = "metadata-test",
    size = "small",
    command = "python3 tools/check-metadata.py",
    data = [
        "Cargo.lock",
        "Cargo.toml",
        "MODULE.bazel",
        "//build:version.bzl",
        "//packages:definitions",
        "//tools:check-metadata.py",
    ],
)
