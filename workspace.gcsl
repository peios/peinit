# The peinit package: pekit builds it with the gcc library's Bootlin C
# toolchain and the rust library's pinned Rust, checks its client library
# with the python library's pinned Python, and gives its tests that run
# shell scripts the buildenv library's busybox.
import Toolchain::* from "github.com/gcslib/buildenv"
import Toolchain::* from "github.com/gcslib/gcc"
import Toolchain::* from "github.com/gcslib/python"
import Toolchain::* from "github.com/gcslib/rust"
import Toolchain from toolchain

pekitconf = {
    toolchains = [
        Toolchain::C gcc_x86_64,
        Toolchain::Rust rust_1_98,
        Toolchain::Python python_3_14,
        Toolchain::BuildEnv busybox_x86_64,
    ]
}
