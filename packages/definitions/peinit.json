{
    "side_effects": ["man-db"],
    "package": {
        "version": "0.0.12-1",
        "architecture": "x86_64",
        "license": "((MIT OR Apache-2.0) AND Unicode-3.0) AND Apache-2.0 AND (Apache-2.0 OR MIT) AND BSD-3-Clause AND ISC AND MIT AND (MIT OR Unlicense)",
        "license_class": "free",
        "homepage": "https://github.com/peios/peinit",
        "name": "dev.peios.peinit",
        "description": "Peios real-root PID 1 service manager"
    },
    "provides": {
        "init": "1"
    },
    "claims": {
        "provides": {
            "init": {
                "bin": {
                    "target": "/usr/bin/peinit2",
                    "path": "/init"
                }
            }
        },
        "dependencies": {
            "registryd": {
                "binary": {
                    "path": "/usr/sbin/registryd"
                }
            }
        }
    },
    "dependencies": {
        "registryd": "*",
        "dev.peios.libpeios": ">= 0.5.8-1",
        "org.gnu.glibc": "*",
        "org.iana.tzdata": "*"
    },
    "files": {
        "source:LICENSE": "usr/share/licenses/dev.peios.peinit/LICENSE",
        "stage:licenses/peinit/**": "usr/share/licenses/dev.peios.peinit/third-party",
        "stage:usr/bin/peinit2": "usr/bin/peinit2",
        "stage:usr/share/man/man8/peinit2.8.gz": "usr/share/man/man8/peinit2.8.gz",
        "source:docs/peinit.regman": "usr/share/regman/peinit.regman",
        "source:docs/peinit.evman": "usr/share/evman/peinit.evman"
    },
    "executables": ["usr/bin/peinit2"]
}
